ENV=development
SECRET_KEY=replace-with-a-random-64-char-secret
DATABASE_URL=postgresql+psycopg2://skyking:skyking@localhost:5432/skyking_crm

MSG91_BASE_URL=https://api.msg91.com/api/v5/hello
MSG91_AUTHKEY=your-msg91-authkey-here
MSG91_COMPANY_ID=109474

# Set to false once you have live MSG91 credentials -- see
# app/services/msg91_client.py for how this switch works.
USE_MOCK_MSG91=true
MOCK_MSG91_FILE=app/mock_data/msg91_tickets_sample.json

DEFAULT_WHATSAPP_INBOX_ID=2271
DEFAULT_SUPPORT_TEAM_ID=2253
DEFAULT_ORIGIN=whatsapp
DEFAULT_ASSIGNEE_TYPE=team

MSG91_SYNC_INTERVAL_SECONDS=60
