# Copy to .env and fill in. Nothing here has a safe default - set real values.
DB_PASSWORD=
SECRET_KEY=                      # long random string:  python -c "import secrets;print(secrets.token_urlsafe(64))"
APP_ENV=production
CORS_ORIGINS=https://crm.example.com
ADMIN_EMAIL=
ADMIN_PASSWORD=                  # >= 10 chars, letters + digits. Used once by `python -m app.seed`
WEBHOOK_SECRET=                  # shared secret for /api/intake/* webhooks
# MSG91 (WhatsApp). Leave USE_MOCK_MSG91=true until credentials and endpoints are confirmed.
USE_MOCK_MSG91=true
MSG91_AUTHKEY=
MSG91_BASE_URL=https://control.msg91.com/api/v5/hello
MSG91_SEND_URL=
# Email intake (IMAP polling). Alternatively POST raw mail to /api/intake/email.
IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD=
